{
  "redirects": [
    {
      "source": "/index.html",
      "has": [
        {
          "type": "host",
          "value": "www.ischiatransferservice.it"
        }
      ],
      "destination": "https://ischiatransferservice.it/",
      "permanent": true
    },
    {
      "source": "/en/index.html",
      "has": [
        {
          "type": "host",
          "value": "www.ischiatransferservice.it"
        }
      ],
      "destination": "https://ischiatransferservice.it/en/",
      "permanent": true
    },
    {
      "source": "/:path*.html",
      "has": [
        {
          "type": "host",
          "value": "www.ischiatransferservice.it"
        }
      ],
      "destination": "https://ischiatransferservice.it/:path*",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/en/index.html",
      "destination": "/en/",
      "permanent": true
    },
    {
      "source": "/:path*.html",
      "destination": "/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.ischiatransferservice.it"
        }
      ],
      "destination": "https://ischiatransferservice.it/:path*",
      "permanent": true
    }
  ]
}
